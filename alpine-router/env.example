# ============================================================
# Alpine Router 部署环境变量模板（仅密钥类数据）
#
# 配置不再经 deploy 部署：全部配置已由 alpine-router-image 仓库的
# CI 烙进镜像，本文件只承载密钥。
#
# 使用方式（在 NAS 宿主机上）：
#   sudo cp env.example /etc/libvirt/alpine-router.env
#   sudo chmod 600 /etc/libvirt/alpine-router.env
#   编辑填入密钥后，重新运行 alpine-router-deploy
#
# 该文件由部署脚本 scp 上传到 VM（仅部署瞬间存在），
# install.sh 结束后即删除。所有变量均可选。
# ============================================================

# SSH 公钥（deploy 通道与日常登录；r3s 出厂 sshd 默认拒绝 root 密码登录，
# 公钥是唯一免密通道。生成：ssh-keygen -t ed25519 -f /etc/libvirt/alpine-router-deploy）
# SSH_PUBLIC_KEY="ssh-ed25519 AAAA..."（占位，真机部署前填入）

# Tailscale 认证密钥（https://login.tailscale.com/admin/settings/keys）
# TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxxxxxx

# Cloudflared Tunnel Token（Zero Trust → Networks → Tunnels → 对应隧道）
# CLOUDFLARED_TOKEN=eyJhIjoi...
