# ============================================================
# Alpine Linux 包列表（VM 路由环境）
#
# 语法：
#   [pm] <package>                —— 包管理器安装（apk add）
#   [dl@<url>] <binary> [sha256]  —— 下载 URL 到 /usr/local/bin/<binary>，可选 sha256 校验
#
# 由 install.sh → lib/packages.sh 解析执行
# ============================================================

# ========== base ==========
[pm] openssh
[pm] chrony
[pm] curl
[pm] wget
[pm] bash
[pm] vim
[pm] nano
[pm] htop
[pm] tcpdump
[pm] iftop
[pm] mtr
[pm] rsync
[pm] iptables
[pm] ip6tables
[pm] nftables
[pm] iproute2
[pm] dnsmasq
[pm] tailscale
# cloudflared 官方 linux-amd64 为静态编译，不区分 glibc/musl，可直接在 Alpine 上运行
# 固定版本 + sha256 校验（不要用 latest，避免供应链风险）
[dl@https://github.com/cloudflare/cloudflared/releases/download/2026.7.3/cloudflared-linux-amd64] cloudflared 9d71c677db00134c1bd4144b7783486b654ad281b1ea62b4972098d19f770f17
